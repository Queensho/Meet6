# Meet6 production operations configuration.
# Installed to /etc/default/meet6-ops on first setup.

# Local health endpoint. It checks Node + PostgreSQL + Redis.
HEALTH_URL=http://127.0.0.1:3100/api/health
HEALTH_TIMEOUT_SECONDS=8
HEALTH_FAILURE_THRESHOLD=3

# Optional heartbeat/ping URL from an external uptime provider.
# The URL is called only after a successful health check.
UPTIME_HEARTBEAT_URL=

# Optional alert webhook. Leave blank to keep alerts in journald/syslog only.
# Supported formats: generic, slack, discord
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_FORMAT=generic

# PM2 structured error log scanned by the 5-minute error watcher.
ERROR_LOG=/var/log/meet6/api-error.log
MEET6_OPS_STATE_DIR=/var/lib/meet6-ops
