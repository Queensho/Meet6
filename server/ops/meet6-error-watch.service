[Unit]
Description=Meet6 application error watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/meet6-ops
ExecStart=/usr/local/sbin/meet6-error-watch
User=root
Group=root
Nice=10
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/var/log/meet6
ReadWritePaths=/var/lib/meet6-ops
NoNewPrivileges=true
