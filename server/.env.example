NODE_ENV=production
PORT=3100
DATABASE_URL=postgresql://meet6_user:CHANGE_ME@127.0.0.1:5432/meet6
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=CHANGE_ME
CORS_ORIGINS=https://queensho.github.io

# Push notifications: configure ONE of these on the VPS.
# Recommended: absolute path to a Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/var/www/meet6/secrets/firebase-service-account.json
# Alternative: the full service-account JSON as a single-line environment value.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
