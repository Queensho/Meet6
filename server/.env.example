NODE_ENV=production
PORT=3100
DATABASE_URL=postgresql://meet6_user:CHANGE_ME@127.0.0.1:5432/meet6
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=CHANGE_ME
CORS_ORIGINS=https://www.meet6.com.tr,https://queensho.github.io
RATE_LIMIT_ENABLED=true
UPLOAD_ROOT=/var/www/meet6/uploads

# Photos awaiting/rejected by moderation are stored outside the public upload root.
MODERATION_QUARANTINE_ROOT=/var/lib/meet6/quarantine

# Google Cloud Vision content moderation. In production, if this is absent or
# unavailable, new photos fail closed into the manual review queue and are not public.
GOOGLE_CLOUD_PROJECT_ID=CHANGE_ME
GOOGLE_VISION_CREDENTIALS=/var/www/meet6/secrets/google-vision-service-account.json
# Alternative: full service-account JSON as a single-line environment value.
# GOOGLE_VISION_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# RevenueCat subscription verification. The secret API key stays on the backend.
# Configure the RevenueCat entitlement identifier as "premium" unless intentionally changed.
REVENUECAT_SECRET_API_KEY=sk_CHANGE_ME
REVENUECAT_PREMIUM_ENTITLEMENT=premium
# Configure the same full Authorization header in the RevenueCat webhook settings.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer CHANGE_ME_LONG_RANDOM_SECRET

# Matchmaking hard filters. Safety/preferences are never relaxed while waiting.
MATCHMAKING_ROOM_REPEAT_HOURS=24
MATCHMAKING_RECENT_MATCH_DAYS=7
MATCHMAKING_RETRY_SECONDS=15
MATCHMAKING_CANDIDATE_POOL=200

# Production backup defaults used by scripts/backup-production.sh.
BACKUP_ROOT=/var/backups/meet6
DB_NAME=meet6
DB_USER=postgres
BACKUP_RETENTION_DAYS=14

# Push notifications: configure ONE of these on the VPS.
# Recommended: absolute path to a Firebase service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/var/www/meet6/secrets/firebase-service-account.json
# Alternative: the full service-account JSON as a single-line environment value.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
